---
import { img } from '../../lib/img';
import VideoToggle from '../shared/VideoToggle.astro';
// Full-bleed cinematic hero. Crossfades 4 Seedance 2 video reels with
// real-photo poster fallbacks. Honors prefers-reduced-motion (videos
// don't autoplay; the first scene's poster image is shown still).

interface Scene {
  videoSrc?: string;
  videoSrcPortrait?: string;
  posterSrc: string;
  alt: string;
}

interface Props {
  scenes?: Scene[];
  eyebrow: string;
  headlinePrefix: string;
  headlineEmphasis: string;
  headlineSuffix?: string;
  subline: string;
  primaryCta: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  trustItems: string[];
}

const {
  scenes = [
    {
      videoSrc: '/media/hero/hero-bvi-01.mp4',
      videoSrcPortrait: '/media/hero/hero-bvi-01-portrait.mp4',
      posterSrc: '/img/stock/hero/hero-bvi-catamaran-turquoise-01.jpg',
      alt: 'A white catamaran sailing on bright turquoise Caribbean water under a clear blue daytime sky',
    },
    {
      videoSrc: '/media/hero/hero-bahamas-02.mp4',
      videoSrcPortrait: '/media/hero/hero-bahamas-02-portrait.mp4',
      posterSrc: '/img/stock/voyages/bahamas/bahamas-hope-town-lighthouse-hero.jpg',
      alt: 'Dawn approach to a pink-sand spit in the Abacos',
    },
    {
      videoSrc: '/media/hero/hero-greece-03.mp4',
      videoSrcPortrait: '/media/hero/hero-greece-03-portrait.mp4',
      posterSrc: '/img/stock/voyages/greece/greece-island-cove-hero.jpg',
      alt: 'A white catamaran anchored in a turquoise Mediterranean island cove ringed by rugged shoreline at golden hour',
    },
    {
      videoSrc: '/media/hero/hero-deck-04.mp4',
      videoSrcPortrait: '/media/hero/hero-deck-04-portrait.mp4',
      posterSrc: '/img/stock/hero/hero-sunset-teak-deck-04.jpg',
      alt: 'A lit brass hurricane lantern and an open book on a teak deck at sunset with anamorphic lens flare',
    },
  ],
  eyebrow,
  headlinePrefix,
  headlineEmphasis,
  headlineSuffix = '',
  subline,
  primaryCta,
  secondaryCta,
  trustItems,
} = Astro.props;

// Each Seedance reel is ~5s. The crossfade is driven from the <script>
// below (not CSS timing) so every clip plays once from frame 0 and never
// loops mid-window. Keep SCENE_MS there in sync with the clip length.

// First scene's still: a real <img> (WebP srcset, high priority) under the
// video instead of a poster= JPG, which can't be resized or prioritised.
// Portrait screens crop a landscape photo to full height, so they need
// (width/height x 100)vh of image, and get WebP only. Wider screens may still
// pick the original JPG at high pixel density, so desktop looks unchanged.
// Later scenes' posters load only when their clip is pre-warmed (script).
const first = img(scenes[0].posterSrc);
const portraitVh = first.width && first.height ? Math.ceil((100 * first.width) / first.height) : 100;
---

<section class="hero relative w-full min-h-[100dvh] overflow-hidden bg-bone text-primary">
  <div class="absolute inset-0 z-0" aria-hidden="true">
    {
      scenes.map((scene, i) => (
        <div
          class:list={['hero-scene absolute inset-0', { 'is-active': i === 0 }]}
          data-hero-scene
        >
          {scene.videoSrc && i === 0 && (
            <picture>
              {first.srcset && (
                <source media="(max-aspect-ratio: 1/1)" type="image/webp" srcset={first.srcset} sizes={`${portraitVh}vh`} />
              )}
              <img
                src={scene.posterSrc}
                srcset={first.srcset ? `${first.srcset}, ${scene.posterSrc} ${first.width}w` : undefined}
                sizes="100vw"
                width={first.width}
                height={first.height}
                alt=""
                loading="eager"
                decoding="async"
                fetchpriority="high"
                class="absolute inset-0 w-full h-full object-cover"
              />
            </picture>
          )}
          {scene.videoSrc ? (
            <video
              muted
              playsinline
              preload={i === 0 ? 'auto' : 'metadata'}
              data-poster={i === 0 ? undefined : scene.posterSrc}
              class:list={['absolute inset-0 w-full h-full object-cover', { 'opacity-0': i === 0 }]}
              data-hero-video
            >
              {scene.videoSrcPortrait && (
                <source media="(max-aspect-ratio: 1/1)" src={scene.videoSrcPortrait} type="video/mp4" />
              )}
              <source src={scene.videoSrc} type="video/mp4" />
            </video>
          ) : (
            <img
              {...img(scene.posterSrc, '100vw')}
              alt=""
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
              fetchpriority={i === 0 ? 'high' : 'auto'}
              class="absolute inset-0 w-full h-full object-cover"
            />
          )}
        </div>
      ))
    }
    <div class="absolute inset-0 bg-gradient-to-t from-bone/95 via-bone/60 via-45% to-transparent"></div>
  </div>

  {/* Below the fixed header (96px, 112px at lg) and above the eyebrow, which
      never starts higher than the content's 128px top padding. */}
  <VideoToggle class="absolute top-[98px] lg:top-28 right-7 lg:right-14 z-20" data-hero-toggle />

  <div class="relative z-10 min-h-[100dvh] flex flex-col">
    <div class="flex-1 flex items-end pb-24 lg:pb-32 px-7 lg:px-14 pt-32">
      <div class="max-w-[1400px] w-full mx-auto">
        <div class="max-w-4xl">
          <p class="font-label-caps uppercase tracking-[0.28em] text-[0.75rem] font-semibold text-primary/70 mb-8">
            {eyebrow}
          </p>
          <h1
            class="font-display text-primary font-light text-pretty leading-[0.95] tracking-[-0.03em]"
            style="font-size: clamp(1.75rem, 4vw + 0.75rem, 3.75rem); font-variation-settings: 'opsz' 144, 'SOFT' 30, 'WONK' 0;"
          >
            {headlinePrefix}
            <span
              class="italic block sm:inline"
              style="font-variation-settings: 'opsz' 144, 'SOFT' 60, 'WONK' 1;"
            >
              {headlineEmphasis}
            </span>
            {headlineSuffix}
          </h1>
          <p class="font-body-lg text-[1.0625rem] lg:text-[1.1875rem] leading-[1.6] text-primary/80 mt-8 max-w-[58ch]">
            {subline}
          </p>
          <div class="flex flex-col sm:flex-row gap-4 sm:gap-6 mt-10 lg:mt-12">
            <a
              href={primaryCta.href}
              data-chat-avoid
              class="group inline-flex items-center justify-center gap-3 cursor-pointer bg-accent text-bone font-label-caps uppercase tracking-[0.22em] text-[0.75rem] font-semibold px-9 py-[18px] hover:bg-accent-hot hover:text-bone transition-colors focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-3"
            >
              {primaryCta.label}
              <svg viewBox="0 0 16 16" class="size-3 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M1 8h13M9 3l5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
            {secondaryCta && (
              <a
                href={secondaryCta.href}
                class="group inline-flex items-center gap-3 cursor-pointer text-primary/80 font-label-caps uppercase tracking-[0.22em] text-[0.75rem] font-semibold pb-1 border-b border-primary/30 hover:text-primary hover:border-primary transition-all"
              >
                {secondaryCta.label}
                <svg viewBox="0 0 16 16" class="size-3 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M1 8h13M9 3l5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            )}
          </div>
        </div>
      </div>
    </div>

    <div class="border-t border-primary/15 backdrop-blur-md bg-bone/40">
      <div class="max-w-[1400px] mx-auto px-7 lg:px-14 py-5 flex flex-wrap items-center gap-x-10 gap-y-3">
        {
          trustItems.map((item) => (
            <span class="inline-flex items-center gap-2.5 font-label-caps uppercase tracking-[0.24em] text-[0.625rem] font-semibold text-primary/85">
              <span class="block size-[6px] bg-accent rounded-full" aria-hidden="true" />
              {item}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* JS-driven crossfade (see <script> below). Opacity is toggled via the
     .is-active class in sync with video playback, so a clip never visibly
     loops mid-window. */
  .hero-scene {
    opacity: 0;
    transition: opacity 900ms ease-in-out;
    will-change: opacity;
  }
  .hero-scene.is-active {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-scene { transition: none; }
  }
</style>

<script>
  import { wireToggle } from '../../lib/video-toggle';
  // Drive the hero crossfade in sync with playback: only the active scene's
  // video plays, always from frame 0, exactly once - then we fade to the
  // next. This eliminates the mid-window loop restart that made every clip
  // look like it was repeating, and avoids drift from 4 videos looping
  // independently. The next clip is pre-warmed so it doesn't flash a poster.
  const SCENE_MS = 5000; // ~clip length; all reels are ~5s
  const scenes = Array.from(document.querySelectorAll('[data-hero-scene]'));

  if (scenes.length > 1) {
    const videos = scenes.map((s) => s.querySelector('video'));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let i = 0;
    let timer = 0;

    // Scene 0's video stays invisible until it really plays, so its <img>
    // still shows (as the old poster did) when motion is reduced or blocked.
    videos[0]?.addEventListener('playing', () => videos[0]?.classList.remove('opacity-0'), { once: true });

    const warm = (k: number) => {
      const v = videos[k];
      if (v?.dataset.poster && !v.getAttribute('poster')) v.poster = v.dataset.poster;
      if (v && v.preload !== 'auto') {
        v.preload = 'auto';
        try { v.load(); } catch {}
      }
    };

    const activate = (idx: number) => {
      scenes.forEach((s, k) => s.classList.toggle('is-active', k === idx));
      videos.forEach((v, k) => {
        if (!v) return;
        if (k === idx) {
          try { v.currentTime = 0; } catch {}
          const p = v.play();
          if (p && p.catch) p.catch(() => {});
        } else {
          v.pause();
        }
      });
      warm((idx + 1) % scenes.length); // pre-buffer the next clip
    };

    const start = () => {
      if (timer) return;
      activate(i);
      timer = window.setInterval(() => {
        i = (i + 1) % scenes.length;
        activate(i);
      }, SCENE_MS);
    };
    const stop = () => {
      if (timer) { clearInterval(timer); timer = 0; }
      videos.forEach((v) => v && v.pause());
    };
    const showStatic = () => {
      stop();
      scenes.forEach((s, k) => s.classList.toggle('is-active', k === 0));
    };

    // Pause button (WCAG 2.2.2). Shown only while motion is allowed.
    let userPaused = false;
    const toggle = document.querySelector<HTMLButtonElement>('[data-hero-toggle]');
    if (toggle) {
      wireToggle(toggle, (paused) => {
        userPaused = paused;
        if (paused) stop();
        else start();
      });
    }

    if (reduce.matches) { showStatic(); if (toggle) toggle.hidden = true; }
    else start();

    reduce.addEventListener?.('change', (e) => {
      if (e.matches) { showStatic(); if (toggle) toggle.hidden = true; }
      else {
        if (toggle) toggle.hidden = false;
        if (!userPaused) { i = 0; start(); }
      }
    });

    // Pause cycling while the tab is hidden (battery + keeps clips in sync).
    document.addEventListener('visibilitychange', () => {
      if (reduce.matches || userPaused) return;
      if (document.hidden) stop();
      else start();
    });
  }
</script>
