---
// Single expanding "speed-dial" launcher. Replaces the two overlapping
// floating buttons (our old phone FAB + GoHighLevel's blue chat bubble) with
// one accent (#E5402B) button that expands to two actions:
//   - Call us       -> tel:+17723103777 (our AI voice line)
//   - Chat with us  -> opens the GoHighLevel (LeadConnector) chat widget
//
// GoHighLevel's own launcher bubble is fully hidden (global CSS for the
// light-DOM case + a shadow-root style injection for the shadow-DOM case) so
// only this one button shows. Rendered once from BaseLayout, gated by
// !hideFloatingCta; LpLayout and /inquire do not render it. Accessible
// (keyboard, aria, prefers-reduced-motion). No localStorage / sessionStorage.
const PHONE_TEL = '+17723103777';
---

<div
  id="gwu-speeddial"
  class="fixed bottom-6 right-6 z-[2147483647] flex flex-col items-end gap-3 print:hidden"
  data-open="false"
>
  <div
    id="gwu-sd-actions"
    class="flex flex-col items-end gap-3 opacity-0 translate-y-2 pointer-events-none transition-all duration-200 motion-reduce:transition-none"
  >
    <a
      href={`tel:${PHONE_TEL}`}
      class="gwu-sd-item group inline-flex items-center gap-3"
      data-sd-item
      tabindex="-1"
    >
      <span class="gwu-sd-pill">Call us</span>
      <span class="grid place-items-center size-12 rounded-full bg-bone text-primary shadow-lg ring-1 ring-primary/10 transition-transform duration-150 group-hover:scale-105 group-focus-visible:outline-2 group-focus-visible:outline-accent group-focus-visible:outline-offset-2 motion-reduce:transition-none">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
      </span>
    </a>

    <button
      type="button"
      data-sd-chat
      data-sd-item
      tabindex="-1"
      class="gwu-sd-item group inline-flex items-center gap-3 cursor-pointer"
    >
      <span class="gwu-sd-pill">Chat with us</span>
      <span class="grid place-items-center size-12 rounded-full bg-bone text-primary shadow-lg ring-1 ring-primary/10 transition-transform duration-150 group-hover:scale-105 group-focus-visible:outline-2 group-focus-visible:outline-accent group-focus-visible:outline-offset-2 motion-reduce:transition-none">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="size-5" aria-hidden="true"><path d="M21 12c0 4.418-4.03 8-9 8-1.4 0-2.728-.282-3.917-.787L3 20l1.27-3.81C3.473 15.029 3 13.563 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </span>
    </button>
  </div>

  <button
    type="button"
    id="gwu-sd-toggle"
    aria-expanded="false"
    aria-controls="gwu-sd-actions"
    aria-label="Contact us: call or chat"
    class="grid place-items-center size-14 rounded-full bg-accent hover:bg-accent-hot text-bone shadow-lg transition-[background-color,transform] duration-150 motion-reduce:transition-none focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-3"
  >
    <svg data-sd-icon="closed" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="size-6" aria-hidden="true"><path d="M21 12c0 4.418-4.03 8-9 8-1.4 0-2.728-.282-3.917-.787L3 20l1.27-3.81C3.473 15.029 3 13.563 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" stroke-linecap="round" stroke-linejoin="round" /></svg>
    <svg data-sd-icon="open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6 hidden" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
  </button>
</div>

{/* Scoped styles for OUR elements. */}
<style>
  .gwu-sd-pill {
    background: var(--color-primary);
    color: var(--color-bone);
    font-family: var(--font-label-caps);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.625rem;
    font-weight: 600;
    padding: 0.5rem 0.75rem;
    white-space: nowrap;
    box-shadow: 0 8px 24px -8px rgba(15, 15, 15, 0.4);
  }
  #gwu-speeddial[data-open='true'] #gwu-sd-actions {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
</style>

{/* GLOBAL styles: hide GoHighLevel's own launcher. is:global is required
    because Astro scopes component <style> by default, and these target the
    third-party LeadConnector elements (light-DOM case). The shadow-DOM case is
    handled by the script below. The chat window itself is a different element
    and still opens. */}
<style is:global>
  #lc_text-widget--btn,
  .lc_text-widget--bubble,
  .lc_text-widget--prompt {
    display: none !important;
  }
</style>

<script>
  const root = document.getElementById('gwu-speeddial');
  const toggle = document.getElementById('gwu-sd-toggle');
  const iconClosed = toggle?.querySelector('[data-sd-icon="closed"]');
  const iconOpen = toggle?.querySelector('[data-sd-icon="open"]');
  const items = Array.from(root?.querySelectorAll('[data-sd-item]') ?? []) as HTMLElement[];

  function setOpen(open: boolean) {
    if (!root || !toggle) return;
    root.setAttribute('data-open', String(open));
    toggle.setAttribute('aria-expanded', String(open));
    iconClosed?.classList.toggle('hidden', open);
    iconOpen?.classList.toggle('hidden', !open);
    items.forEach((el) => el.setAttribute('tabindex', open ? '0' : '-1'));
  }
  const isOpen = () => root?.getAttribute('data-open') === 'true';

  toggle?.addEventListener('click', () => {
    const next = !isOpen();
    setOpen(next);
    if (next) items[0]?.focus();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen()) {
      setOpen(false);
      toggle?.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (isOpen() && root && !root.contains(e.target as Node)) setOpen(false);
  });

  /* ---- GoHighLevel (LeadConnector) chat control ------------------------- */

  function ghlWidget() {
    return document.querySelector('chat-widget') as (HTMLElement & { shadowRoot: ShadowRoot | null }) | null;
  }

  // The launcher may be in the light DOM or in the widget's shadow root.
  function findLauncher(): HTMLElement | null {
    const light = document.getElementById('lc_text-widget--btn') as HTMLElement | null;
    if (light) return light;
    const sr = ghlWidget()?.shadowRoot;
    if (sr) {
      return (sr.getElementById('lc_text-widget--btn') ||
        sr.querySelector('.lc_text-widget--bubble')) as HTMLElement | null;
    }
    return document.querySelector('.lc_text-widget--bubble') as HTMLElement | null;
  }

  function openGhlChat() {
    const btn = findLauncher();
    if (btn) {
      btn.click();
      return true;
    }
    const cw = ghlWidget() as (HTMLElement & Record<string, unknown>) | null;
    if (cw) {
      for (const m of ['openWidget', 'open', 'show', 'loadWidget', 'maximize']) {
        const fn = cw[m];
        if (typeof fn === 'function') {
          try {
            (fn as () => void).call(cw);
            return true;
          } catch {
            /* try next */
          }
        }
      }
    }
    return false;
  }

  document.querySelector('[data-sd-chat]')?.addEventListener('click', () => {
    openGhlChat();
    setOpen(false);
  });

  // If the launcher lives in the widget's shadow root, page CSS can't reach it
  // - inject a hiding style in there once the element mounts. Idempotent; keeps
  // polling briefly because the widget mounts and re-renders asynchronously.
  function hideLauncherInShadow() {
    const sr = ghlWidget()?.shadowRoot;
    if (!sr) return;
    if (!sr.getElementById('gwu-hide-launcher')) {
      const style = document.createElement('style');
      style.id = 'gwu-hide-launcher';
      style.textContent =
        '#lc_text-widget--btn,.lc_text-widget--bubble,.lc_text-widget--prompt{display:none !important;}';
      sr.appendChild(style);
    }
  }
  let ticks = 0;
  const poll = setInterval(() => {
    hideLauncherInShadow();
    if (++ticks > 60) clearInterval(poll); // ~30s cap
  }, 500);
</script>

{/* GoHighLevel / LeadConnector chat widget loader. is:inline keeps Astro from
    bundling the tag so the data-* attributes reach the third-party loader
    exactly as written. */}
<script is:inline src="https://widgets.leadconnectorhq.com/loader.js" data-resources-url="https://widgets.leadconnectorhq.com/chat-widget/loader.js" data-widget-id="6a59601dd166a8719fbec7d2"></script>
