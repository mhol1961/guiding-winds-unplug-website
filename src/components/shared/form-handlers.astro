---
// Vanilla TS that progressively enhances any form with [data-inquiry-form]
// or [data-newsletter] to submit via fetch - so we can render the
// success/error/mailto-fallback inline without a full page reload.
// Forms still work without JS via standard form submission to /api/*.
//
// XSS safety note: all dynamic strings are placed via textContent;
// links are constructed with createElement so the href is set via
// the .href property which the browser auto-encodes. We never use
// innerHTML or insertAdjacentHTML.
---

<script>
  type StatusEl = HTMLElement;

  function clearStatus(el: StatusEl | null) {
    if (!el) return;
    el.textContent = '';
    while (el.firstChild) el.removeChild(el.firstChild);
    el.classList.remove('text-accent', 'text-ink-soft', 'text-ink-mute');
  }

  function setStatusText(el: StatusEl | null, msg: string, kind: 'ok' | 'err' | 'info') {
    if (!el) return;
    clearStatus(el);
    el.textContent = msg;
    el.classList.add(
      kind === 'ok' ? 'text-accent' : kind === 'err' ? 'text-accent' : 'text-ink-soft',
    );
  }

  function setStatusWithMailto(el: StatusEl | null, message: string, mailto: string) {
    if (!el) return;
    clearStatus(el);
    el.append(document.createTextNode(message + ' '));
    const link = document.createElement('a');
    link.href = mailto;
    link.className = 'underline';
    link.textContent = 'Send by email →';
    el.append(link);
    el.classList.add('text-accent');
  }

  // Ad source kept by FormScripts.astro for this session (utm_*, fbclid).
  function attribution(): Record<string, string> {
    try {
      return JSON.parse(sessionStorage.getItem('gw_attr') ?? '{}');
    } catch {
      return {};
    }
  }

  // Turnstile tokens are single-use; get a fresh one after every attempt.
  function resetTurnstile(form: HTMLFormElement) {
    const widget = form.querySelector<HTMLElement>('.cf-turnstile');
    const turnstile = (window as { turnstile?: { reset: (el: HTMLElement) => void } }).turnstile;
    if (widget && turnstile) turnstile.reset(widget);
  }

  // Swap a button to a busy label, and return a function that restores its own label.
  function busy(btn: HTMLButtonElement | null, label: string): () => void {
    if (!btn) return () => {};
    const original = [...btn.childNodes].map((n) => n.cloneNode(true));
    btn.disabled = true;
    btn.textContent = label;
    return () => {
      btn.disabled = false;
      btn.replaceChildren(...original);
    };
  }

  // Resolve with the Turnstile token, waiting (and loading the widget if a
  // fast visitor got here first) for up to 20s; null if it never arrives.
  async function turnstileToken(form: HTMLFormElement): Promise<string | null> {
    if (!form.querySelector('.cf-turnstile')) return '';
    (window as { gwLoadTurnstile?: () => void }).gwLoadTurnstile?.();
    for (let waited = 0; waited < 20000; waited += 250) {
      const v = form.querySelector<HTMLInputElement>('input[name="cf-turnstile-response"]')?.value;
      if (v) return v;
      await new Promise((r) => setTimeout(r, 250));
    }
    return null;
  }

  // Loaded but no token = the visitor still has to tick the box; not loaded = offer phone/email.
  function noTokenMessage(): string {
    return (window as { turnstile?: unknown }).turnstile
      ? 'Please complete the security check above, then send again.'
      : 'The security check did not load. Please call (772) 310-3777 or email guidingwindsunplug@gmail.com.';
  }

  async function postForm(form: HTMLFormElement, endpoint: string): Promise<Response> {
    const data = new FormData(form);
    for (const [k, v] of Object.entries(attribution())) if (!data.has(k)) data.set(k, String(v));
    return fetch(endpoint, {
      method: 'POST',
      headers: { Accept: 'application/json' },
      body: data,
    });
  }

  // Inquiry forms
  document.querySelectorAll<HTMLFormElement>('form[data-inquiry-form]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = form.querySelector<HTMLElement>('[data-inquiry-status]');
      const restore = busy(form.querySelector<HTMLButtonElement>('button[type="submit"]'), 'Sending…');
      clearStatus(status);
      if ((await turnstileToken(form)) === null) {
        setStatusWithMailto(status, noTokenMessage(), 'mailto:guidingwindsunplug@gmail.com?subject=Inquiry');
        restore();
        return;
      }

      try {
        const res = await postForm(form, form.action);
        const json = (await res.json().catch(() => ({}))) as {
          ok?: boolean;
          message?: string;
          error?: string;
          mailto?: string;
        };

        if (res.ok && json.ok !== false) {
          // Prefills the intro-call picker on the thank-you page (this tab
          // only). Read before reset() clears the fields.
          const sent = new FormData(form);
          try {
            sessionStorage.setItem('gw_lead', JSON.stringify({
              firstName: String(sent.get('firstName') ?? ''),
              email: String(sent.get('email') ?? ''),
            }));
          } catch {}
          form.reset();
          // One-time flag the thank-you page consumes to fire the Meta Pixel
          // Lead exactly once per real submission (not on refresh/back/direct visit).
          try { sessionStorage.setItem('gw_inquiry_lead', '1'); } catch {}
          window.location.href = '/inquire/thank-you';
          return;
        }

        if (json.mailto && typeof json.mailto === 'string' && json.mailto.startsWith('mailto:')) {
          setStatusWithMailto(status, json.error ?? 'Form is temporarily down.', json.mailto);
        } else {
          setStatusText(status, json.error ?? 'Something went wrong. Try again.', 'err');
        }
      } catch {
        setStatusWithMailto(
          status,
          'Network issue.',
          'mailto:guidingwindsunplug@gmail.com?subject=Inquiry',
        );
      } finally {
        restore();
        resetTurnstile(form);
      }
    });
  });

  // Newsletter forms
  document.querySelectorAll<HTMLFormElement>('form[data-newsletter]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = form.querySelector<HTMLElement>('[data-newsletter-status]');
      const restore = busy(form.querySelector<HTMLButtonElement>('button[type="submit"]'), 'Subscribing…');
      clearStatus(status);
      if ((await turnstileToken(form)) === null) {
        setStatusText(status, noTokenMessage(), 'err');
        restore();
        return;
      }

      try {
        const res = await postForm(form, '/api/newsletter');
        const json = (await res.json().catch(() => ({}))) as {
          ok?: boolean;
          message?: string;
          error?: string;
        };

        if (res.ok && json.ok !== false) {
          form.reset();
          setStatusText(status, json.message ?? 'Subscribed.', 'ok');
        } else {
          setStatusText(status, json.error ?? 'Subscription failed. Try again.', 'err');
        }
      } catch {
        setStatusText(status, 'Network issue. Try again in a moment.', 'err');
      } finally {
        restore();
        resetTurnstile(form);
      }
    });
  });
</script>
