# Security headers (HSTS, CSP, nosniff, framing, CORP) are set on every
# response by src/worker.ts (rules in src/lib/edge.ts), so they also cover
# API routes and redirects. This file only sets caching.

# Long-cache the immutable build hashes.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts: long-cache.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Robots and llms — fresh enough to update without a redeploy delay.
/robots.txt
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600

# /calendar is dynamically rendered — short cache so cabin counts stay fresh
# without a full rebuild.
/calendar
  Cache-Control: public, max-age=900, s-maxage=900
